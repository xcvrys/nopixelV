{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nopixelv",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
